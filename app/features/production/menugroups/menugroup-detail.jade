.detailForm
    detail-header
    .detailContent(layout="row" flex)
        div.detailLeftPanel(flex layout="column")
            div.detailLeftPanelContainer(layout-fill)
                div.detailTopPanel(layout-padding)
                    include ./tabs/top-panel.jade
                div.detailSection(layout-padding)
                    h4 Assigned Menus
                    table.table.table-responsive
                        thead
                            th Name
                            th Description
                            th.text-right
                                button.btn.btn-primary.btn-xs(ng-click="vm.toggleMenuSelector()") {{vm.menuSelectorLabel || 'Add Menu'}}
                        tbody
                            tr(ng-repeat="item in vm.docSvc.doc.menus track by $index")
                                td {{item.name ? item.name : item.title}}
                                td {{item.description}}
                                td(style="padding: 4px;")
                                    list-item-buttons(id-val="item._id" delete-fn="vm.deleteMenu(idVal)" details-fn="vm.detailsLink(idVal)")
                    h4 Assigned Menus New Section
                    include ./tabs/tab-menus.jade
        div.detailRightPanel(flex="20" ng-show="vm._menuSelectorOpen" layout-padding)
            md-content(layout-padding style="background: transparent")
                div()
                    h3 Add Menu
                    .form-group
                        input.form-control(ng-model="searchText", placeholder="Filter Visible")
                    div(ng-repeat="item in vm.menusForSelector | filter:searchText | orderBy:'-name'")
                        a(href="" ng-click="vm.addMenu(item)") 
                            span.glyphicon.glyphicon-circle-arrow-left 
                        span &nbsp; {{item.name}}
    detail-footer