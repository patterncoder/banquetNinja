table.table.table-responsive
    thead
        th Name
        th URL Name
        th.text-right
            button.btn.btn-primary.btn-xs(ng-click="vm.toggleMenuSelector()") {{vm.menuSelectorLabel || 'Add Menu'}}
    tbody
        tr(ng-repeat="item in vm.docSvc.doc.groupMenus track by $index")
            td {{item.menuId.name ? item.menuId.name : item.title}}
            td {{item.referenceName}}
            td(style="padding: 4px;")
                list-item-buttons(id-val="item.menuId._id" delete-fn="vm.deleteGroupMenu(idVal)" edit-fn="vm.editMenuInGroup(idVal, item)" details-fn="vm.detailsLink(idVal)")
