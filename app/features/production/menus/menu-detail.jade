.detailForm(ng-cloak)
    detail-header
    .detailContent(layout="row" flex)
        div.detailLeftPanel(flex layout="column")
            div.detailLeftPanelContainer(layout-fill)
                div.detailTopPanel(layout-padding)
                    include ./tabs/top-panel.jade
                div.detailSection(layout-padding)
                    div(style="font-size: 1.5em; font-weight: bold;") Menu Sections
                    md-tabs.with-overflow(md-dynamic-height  layout="column" md-selected="vm.tabIndex")
                        md-tab(ng-repeat="tabs in vm.docSvc.doc.sections track by $index" label="{{tabs.title}}" ng-click="vm.docSvc.setIndex(vm.tabIndex)")
                            include ./tabs/section-food.jade
                        md-tab(label="Sections Details")
                            include ./tabs/tab-sections2.jade
                div.insideDetailFooter(layout="row" layout-padding layout-align="start start")
        div.detailRightPanel(flex="20" ng-show="vm.toggleAddMenuItems" layout-padding)
            div(layout="row" layout-align="end start")
                md-button( ng-click="vm.toggleAddMenuItems = !vm.toggleAddMenuItems") Close
            div(layout="row" )
                div(layout="column")
                    h3 Add Menu Item
                    md-button( ng-click="vm.createNewMenuItem()") Create New
                    h4 Find Existing
                    h5 Title like:
                    input.form-control(ng-model="titleLike")
                    h5 Description like:
                    input.form-control(ng-model="descriptionLike")
                    h5 Category is:
                    input.form-control(ng-model="categoryIs")
                    md-button( ng-click="vm.searchForMenuItems(titleLike, descriptionLike, categoryIs)") Search
                    div.itemCard(ng-repeat="item in vm.selectableMenuItems" style="border: solid black 1px; background-color: white"  uib-tooltip="{{item.description || 'No description'}}" tooltip-popup-delay='500' tooltip-placement="left")
                        a(href="" ng-click="vm.docSvc.addMenuItem(vm.tabIndex, item)") 
                            span.glyphicon.glyphicon-circle-arrow-left 
                        span() &nbsp; {{item.name}}
    detail-footer