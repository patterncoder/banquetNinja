ninja-grid(no-data-text="Add a size and link recipes..." 
        grid-title="Recipes and Sizes" 
        doc-svc="vm.docSvc" 
        list="vm.docSvc.doc.sizes" 
        create-method="" 
        update-method="" 
        delete-method="removeSize"
        add-toggle="vm.openSizesPanel"
        fields="{size: {input: 'text', header: 'Size', order: 10, width: 10, type: 'number'}, " +
            "scaleFactor: {input: 'text', header: 'Scale Factor', order: 10, width: 10, type: 'number'}, " +
            "recipeName: {input: 'text', header: 'Recipe Name', order: 20, width: 15, type: 'string'}}" 
        )