form(name="vm.detailForm")
div(flex="100" align-content="flex-start" layout="column")
    div(layout="row" flex)
        .form-group(flex=33)
            label.control-label(for="name") Menu Item Name
            input.form-control(name="name" placeholder="Name" ng-model="vm.docSvc.doc.name" )
        .form-group(flex)
            label.control-label(for="description") Description
            textarea.form-control(name="description" rows="3" placeholder="Description" ng-model="vm.docSvc.doc.description")
    div(layout="row" flex)
        .form-group(flex=33)
            label.control-label(for="title") Title
            input.form-control(name="title" placeholder="Title" ng-model="vm.docSvc.doc.title" )
        .form-group(flex)
            label.control-label(for="subTitle") Subtitle
            textarea.form-control(name="subTitle" rows="3" placeholder="Subtitle" ng-model="vm.docSvc.doc.subTitle")
    div(layout="row")
                .form-group(layout="column" flex="50")
                    label Categories
                    div(layout="row")
                        button.btn.btn-primary(type="button" ng-repeat="item in vm.docSvc.doc.categories" style="margin-right: 4px;" ng-click="vm.docSvc.removeCategory(item)") {{item}} &nbsp;&nbsp;
                            span.badge
                                span.glyphicon.glyphicon-remove
                        .btn-round.btn-sm(ng-show="!vm.panels.categoryPanel"  ng-click="vm.openPanel('categoryPanel')"  style="padding-left: 4px; margin-top:3px; padding-top: 4px; color: white; background-color: #337ab7")
                            span.glyphicon.glyphicon-plus( style="margin-left: 4px; margin-top: 3px;")
