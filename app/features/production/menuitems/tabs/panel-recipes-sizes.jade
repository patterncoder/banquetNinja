div.detailRightPanel(ng-show="vm.panels.sizesPanel" flex="20"  layout-padding)
    md-content(layout-padding style="background: transparent")
        div(layout="row" layout-align="end start")
            md-button(ng-click="vm.closePanels()") Close
            div(layout="row" )
        div(layout="column")
            h3 Recipes
            p Only recipes with category of 'Menu Item' will appear.
            h5 Name like:
            input.form-control(ng-model="nameLike")
            h5 Category like:
            input.form-control(ng-model="categoryLike")
            .form-group
              span.help-block(id="companyName-helpBlock" ng-show="true") {{'At least one search criteria is required.'}}
            md-button( ng-click="vm.searchForRecipes(nameLike, categoryLike)") Search
            div.itemCard(ng-repeat="item in vm.selectableRecipes" style="border: solid black 1px; background-color: white")
                a(href="" ng-click="vm.docSvc.linkRecipe(item)") 
                    span.glyphicon.glyphicon-circle-arrow-left 
                span() &nbsp; {{item.name}}