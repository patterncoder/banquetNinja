div(flex="100")
    list-header
    alpha-select(on-select="vm.changeFilter({value: letter})")
    table.table.table-responsive
        colgroup
            col(span="1")
            col(span="1")
            col(span="1")
            col.tableNav(span="1")
        thead
            th Ingredient
            th Categories
            th Storage Locations
            th.text-right
                button.btn.btn-primary.btn-xs(ng-click="vm.addItemDialog()") {{::vm.constructorArgs.addHeaderText}}
        tbody
            //- tr(ng-repeat="item in vm.items | filter:searchText | orderBy:sortOrder" ng-show="vm.getFilterChar(vm.stripNums(item)) == vm.activeFilter")
            tr(ng-repeat="item in vm.items | filter:searchText | orderBy:vm.sortOrder")
                td
                  button.textonlyblue(ng-click="vm.details(item._id)") {{::item.name}}
                td
                  span(ng-repeat="cat in item.categories") {{::cat }}
                    span(ng-if="!$last")&nbsp;|&nbsp;
                td
                  span(ng-repeat="locat in item.storageLocations") {{::locat }}
                    span(ng-if="!$last")&nbsp;|&nbsp;
                td(style="padding: 4px;")
                    list-item-buttons(id-val="item._id" delete-fn="vm.deleteItem(idVal)" edit-fn="vm.details(idVal)")