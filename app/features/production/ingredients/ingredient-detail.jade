.detailForm(ng-cloak)
    detail-header
    .detailContent(layout="row" flex)
        div.detailLeftPanel(flex layout="column")
            div.detailLeftPanelContainer(layout-fill)
                div.detailTopPanel(layout-padding)
                    include ./tabs/top-panel.jade                
                div.detailSection(layout-padding)
                    md-tabs(md-dynamic-height  layout="column" md-selected="vm.tabIndex")
                        md-tab( label="Units")
                            .panel.panel-default
                                .panel-body This tab will catalog how the ingredient will be used in recipes and inventory lists
                        md-tab( label="Vendors")
                            .panel.panel-default
                                .panel-body This will catalog how the ingredient is purchases and from what vendors
                //- div.insideDetailFooter(layout="row" layout-padding layout-align="start start")
                //-     div Some text here.
        div.detailRightPanel(ng-show="vm.categoryPanelOpen" flex="20"  layout-padding)
            md-content(layout-padding style="background: transparent")
                div(layout="row" layout-align="end start")
                    md-button(ng-click="vm.categoryPanelOpen = !vm.categoryPanelOpen") Close
                div(layout="row" )
                    div(layout="column")
                        h3 Add Category
                        //- a(href="") Add categories to the list
                        lookups(tm-data-source="IngredientCategories" limit-to-list doc-list="vm.docSvc.doc.categories" list="root" doc-service-add-method="tmIngredientDocSvc.addCategory")
                            div.itemCard(style="border: solid black 1px; background-color: white")
                                a(href="" ng-click="dCtrl.addItem(item)") 
                                    span.glyphicon.glyphicon-circle-arrow-left 
                                span &nbsp; {{item}}
    detail-footer