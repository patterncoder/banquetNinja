div.detailRightPanel(ng-show="vm.panels.storageLocatPanel" flex="20"  layout-padding)
            md-content(layout-padding style="background: transparent")
                div(layout="row" layout-align="end start")
                    md-button(ng-click="vm.closePanels('storageLocatPanel')") Close
                div(layout="row" )
                    div(layout="column")
                        h3 Add Storage Location
                        .form-group() 
                          label New Location
                          div(layout="row")
                              .btn-round.btn-sm(ng-click="vm.addNewStorLocat(newStorageLocation)"  style="padding-left: 4px; margin-top:3px; padding-top: 4px; color: white; background-color: #337ab7")
                                  span.glyphicon.glyphicon-arrow-left( style="margin-left: 4px; margin-top: 3px;")
                              input.form-control(ng-model="newStorageLocation" style="margin-left: 3px;")
                        //- a(href="") Add categories to the list
                        lookups(tm-data-source="IngredientStorageLocations" limit-to-list doc-list="vm.docSvc.doc.storageLocations" list="root" doc-service-add-method="tmIngredientDocSvc.addStorLocat")
                            div.itemCard(style="border: solid black 1px; background-color: white")
                                a(href="" ng-click="dCtrl.addItem(item)") 
                                    span.glyphicon.glyphicon-circle-arrow-left 
                                span &nbsp; {{item}}