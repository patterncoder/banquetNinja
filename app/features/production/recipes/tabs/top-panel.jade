form(name="vm.detailForm")
    div(flex layout="row")
        div(flex="100" align-content="flex-start" layout="column")
            div(layout="row")
                .form-group(flex="30")
                    label.control-label(for="name") Recipe Name
                    input.form-control(ng-model="vm.docSvc.doc.name" )
                .form-group(flex="70")
                    label.control-label(for="description") Description
                    input.form-control(ng-model="vm.docSvc.doc.description")
            div(layout="row")
                .form-group(flex="15")
                    label.control-label(for="name") Shelf Life (days)
                    input.form-control(ng-model="vm.docSvc.doc.shelfLife" )
                .form-group(flex="85")
                    label.control-label(for="name") Storage Instructions
                    input.form-control(ng-model="vm.docSvc.doc.storageInstructions" )
            div(layout="row")
                .form-group(flex="25")
                    label.control-label(for="name") Prep Time (minutes)
                    input.form-control(ng-model="vm.docSvc.doc.prepTime")
                .form-group(flex="25")
                    label.control-label(for="name") Skill Level
                    input.form-control(ng-model="vm.docSvc.doc.skillLevel")
                .form-group(flex="25")
                    label.control-label(for="name") Yield
                    input.form-control(ng-model="vm.docSvc.doc.yield")
                .form-group(flex="25")
                    label.control-label(for="name") Developer
                    input.form-control(ng-model="vm.docSvc.doc.developer")
            div(layout="row")
                .form-group(flex="100")
                    label.control-label(for="name") Notes
                    input.form-control(ng-model="vm.docSvc.doc.notes")
            div(layout="row")
                .form-group(layout="column" flex="50")
                    label Categories
                    div(layout="row")
                        button.btn.btn-primary(type="button" ng-repeat="item in vm.docSvc.doc.categories" style="margin-right: 4px;" ng-click="vm.docSvc.removeCategory(item)") {{item}} &nbsp;&nbsp;
                            span.badge
                                span.glyphicon.glyphicon-remove
                        .btn-round.btn-sm(ng-show="!vm.categoryPanelOpen"  ng-click="vm.categoryPanelOpen = !vm.categoryPanelOpen"  style="padding-left: 4px; margin-top:3px; padding-top: 4px; color: white; background-color: #337ab7")
                            span.glyphicon.glyphicon-plus( style="margin-left: 4px; margin-top: 3px;")
                .form-group(layout="column" flex="50")
                    label Stations
                    div(layout="row")
                        button.btn.btn-primary(type="button" ng-repeat="item in vm.docSvc.doc.stations" style="margin-right: 4px;" ng-click="vm.docSvc.removeStation(item)") {{item}} &nbsp;&nbsp;
                            span.badge
                                span.glyphicon.glyphicon-remove
                        .btn-round.btn-sm(ng-show="!vm.stationPanelOpen"  ng-click="vm.stationPanelOpen = !vm.stationPanelOpen"  style="padding-left: 4px; margin-top:3px; padding-top: 4px; color: white; background-color: #337ab7")
                            span.glyphicon.glyphicon-plus( style="margin-left: 4px; margin-top: 3px;")
