div.detailRightPanel(ng-show="vm.panels.stationPanel" flex="20"  layout-padding)
    md-content(layout-padding style="background: transparent")
        div(layout="row" layout-align="end start")
            md-button(ng-click="vm.closePanels('stationPanel')") Close
        div(layout="row" )
            div(layout="column")
                h3 Add Station
                .form-group() 
                    label New Station
                    div(layout="row")
                        .btn-round.btn-sm(ng-click="vm.addNewStation(newStationName)"  style="padding-left: 4px; margin-top:3px; padding-top: 4px; color: white; background-color: #337ab7")
                            span.glyphicon.glyphicon-arrow-left( style="margin-left: 4px; margin-top: 3px;")
                        input.form-control(ng-model="newStationName" style="margin-left: 3px;")
                lookups(tm-data-source="RecipeStations" limit-to-list doc-list="vm.docSvc.doc.stations" list="root" doc-service-add-method="tmRecipeDocSvc.addStation")
                    div.itemCard(style="border: solid black 1px; background-color: white")
                        a(href="" ng-click="dCtrl.addItem(item)") 
                            span.glyphicon.glyphicon-circle-arrow-left 
                        span &nbsp; {{item}}
        