div.detailRightPanel(flex="20" ng-show="vm.panels.recipePanel && vm.tabIndex == 1" layout-padding)
    div(layout="row" layout-align="end start")
        md-button( ng-click="vm.closePanels('recipePanel')") Close
    div(layout="row" )
        div(layout="column")
            h3 Recipes
            //- md-button( ng-click="vm.createIngredient()") Create New
            h5 Name like:
            input.form-control(ng-model="recNameLike")
            h5 Category like:
            input.form-control(ng-model="recCategoryLike")
            .form-group
              span.help-block(id="companyName-helpBlock" ng-show="true") {{'At least one search criteria is required.'}}
            md-button( ng-click="vm.searchForRecipes(recNameLike, recCategoryLike)") Search
            div.itemCard(ng-repeat="item in vm.selectableRecipes" style="border: solid black 1px; background-color: white")
                a(href="" ng-click="vm.docSvc.addRecipe(item)") 
                    span.glyphicon.glyphicon-circle-arrow-left 
                span() &nbsp; {{item.name}}